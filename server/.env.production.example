# ==============================================================================
# Amazing Ads Backend - VPS Production Environment Variables
# Copy this file to .env in the server folder: cp .env.production.example .env
# ==============================================================================

# Server Port (Must match PM2 & Nginx proxy pass port)
PORT=5027

# Client Origin (Domain of the frontend)
CLIENT_ORIGIN=https://amazingads.gemshine.tech

# MongoDB Connection String on VPS:
# Default local MongoDB (without auth):
MONGODB_URI=mongodb://127.0.0.1:27017/calendar_billing
# If you configured MongoDB with a username & password:
# MONGODB_URI=mongodb://adminUser:StrongPasswordHere@127.0.0.1:27017/calendar_billing?authSource=admin

# JWT Authentication
JWT_SECRET=amazingads_billing_jwt_secure_key_vps_production_2026
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=production

